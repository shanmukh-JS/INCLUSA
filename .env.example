# -------------------------------------------------------------
# INCLUSA Environment Variables Configuration Template
# Copy this file to .env.local and fill in your values
# -------------------------------------------------------------

# Supabase Configuration (PostgreSQL Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Multimodal AI Engines (At least one recommended for live AI transformations)
GEMINI_API_KEY=your-google-gemini-api-key
NEXT_PUBLIC_GEMINI_API_KEY=your-google-gemini-api-key
# OPENAI_API_KEY=sk-your-openai-api-key

# Application Settings
NEXT_PUBLIC_APP_NAME=INCLUSA
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
